{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicEditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::builds/earshot/editions/beta/*"
      ]
    },
    {
      "Sid": "PublicDeviceEditions",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::builds/green-in-between/*",
        "arn:aws:s3:::builds/navi/*"
      ]
    },
    {
      "Sid": "Pointers",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::builds/earshot/latest.json",
        "arn:aws:s3:::builds/earshot/inflight.json",
        "arn:aws:s3:::builds/gruvato/latest.json",
        "arn:aws:s3:::builds/gruvato/inflight.json",
        "arn:aws:s3:::builds/shortwave/latest.json",
        "arn:aws:s3:::builds/shortwave/inflight.json",
        "arn:aws:s3:::builds/tower-of-lost-things/latest.json",
        "arn:aws:s3:::builds/tower-of-lost-things/inflight.json"
      ]
    },
    {
      "Sid": "IpadOverTheAir",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::builds/gruvato/index.html",
        "arn:aws:s3:::builds/gruvato/ios/manifest.plist",
        "arn:aws:s3:::builds/gruvato/*.ipa",
        "arn:aws:s3:::builds/gruvato/*/icon-57.png",
        "arn:aws:s3:::builds/gruvato/*/icon-512.png",
        "arn:aws:s3:::builds/tower-of-lost-things/index.html",
        "arn:aws:s3:::builds/tower-of-lost-things/ios/manifest.plist",
        "arn:aws:s3:::builds/tower-of-lost-things/*.ipa",
        "arn:aws:s3:::builds/tower-of-lost-things/*/icon-57.png",
        "arn:aws:s3:::builds/tower-of-lost-things/*/icon-512.png"
      ]
    },
    {
      "Sid": "BuildIndex",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "*"
        ]
      },
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::builds/index.html",
        "arn:aws:s3:::builds/index.json"
      ]
    }
  ]
}
